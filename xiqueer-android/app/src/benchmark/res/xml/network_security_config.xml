<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 benchmark 变体:允许明文 HTTP,以便用宿主机的假 LLM 服务做**压缩包全流程冒烟**。

  为什么需要这份:release/benchmark 默认走平台默认策略(禁止明文),
  于是 R8 包里根本连不上 `http://10.0.2.2:8787`,AI 那条链(工具执行、写操作确认门)
  在压缩包里就没有办法被验证。而"R8 把某条路径弄坏"这类问题**只在压缩包里出现**。

  ⚠️ 这是 benchmark 变体与 release 的**唯一**差异,只对本地回环地址放行;
  release 不包含这份配置(已用 aapt2 dump 核对过:release manifest 无 networkSecurityConfig)。
  也就是说:benchmark 包可以用来验证功能性,但**不能**用来验证"release 的网络策略"。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
